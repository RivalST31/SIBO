# Static assets and configuration files must be served as-is and return 404 if missing, never falling back to index.html
/assets/* /assets/:splat 200
/manifest.json /manifest.json 200
/favicon.ico /favicon.ico 200
/icons/* /icons/:splat 200
/sw.js /sw.js 200

# Fallback all other routes to index.html to support SPA client-side routing
/* /index.html 200
